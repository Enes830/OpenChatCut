FROM node:22-bookworm-slim

WORKDIR /app

# Install FFmpeg and Chrome Headless shared libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    python3 \
    make \
    g++ \
    libnspr4 libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 \
    libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

RUN npm ci --ignore-scripts && \
    chmod -R +x node_modules/@ffprobe-installer/ node_modules/ffmpeg-static/ 2>/dev/null || true

# Pre-download Chrome Headless Shell for @remotion/renderer
RUN node -e "import('@remotion/renderer').then(r => r.ensureBrowser())"

# Copy source needed for Remotion bundling & server-side rendering
COPY . .

# Pre-build the Remotion serve bundle so runtime renders skip webpack (~14s saved per job)
RUN node -e "import('./remotion/serve-bundle.mjs').then(m => m.prebuildServeBundle('/app/remotion-bundle'))"

ENV NODE_ENV=production \
    PORT=8080 \
    CC_REMOTION_BUNDLE=/app/remotion-bundle \
    CC_RENDER_GL=swangle

EXPOSE 8080

CMD ["node", "scripts/fly-render-worker.mjs"]
